# サーバー
PORT=8080
GRPC_PORT=9090
ADMIN_PORT=6060
LOG_LEVEL=info
ENV=local

# PostgreSQL(make db-up で起動するコンテナに合わせています)
DATABASE_URL=postgres://knock:knock@localhost:5432/knock?sslmode=disable
TEST_DATABASE_URL=postgres://knock:knock@localhost:5432/knock_test?sslmode=disable

# オブジェクトストレージ(MinIO / S3 互換)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=knock
S3_SECRET_KEY=knockknock
S3_BUCKET=attachments

# 可観測性(--profile observability で起動)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
