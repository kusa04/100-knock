# サーバー
PORT=8080
LOG_LEVEL=info

# アップロード上限
MAX_REQUEST_BYTES=16777216   # 16MB: リクエスト全体(http.MaxBytesReader)
MAX_FILE_BYTES=15728640      # 15MB: 1 ファイルあたり(ReadAndValidateSize)
MAX_PARTS=1000               # 1 リクエストあたりのパート数上限

# 保存先: local | s3
STORAGE=local
UPLOAD_DIR=./uploads

# オブジェクトストレージ(MinIO / S3 互換。make minio-up で起動するコンテナに合わせています)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=knock
S3_SECRET_KEY=knockknock
S3_BUCKET=uploads
